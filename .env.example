# ==============================================================================
# SlothFridge Environment Variables Configuration Template
# Copy this file to .env and fill in your respective API credentials:
# cp .env.example .env
# ==============================================================================

# Groq Cloud API Key (for Gemma 2 9B IT recipe synthesis)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs API Key (for George deadpan sleepy audio narration stream)
# Obtain from: https://elevenlabs.io
ELEVENLABS_API_KEY=

# PriorLabs TabPFN Token (for TabPFN 3.5 prior classification and regression)
# Obtain from: https://ux.priorlabs.ai/account
TABPFN_TOKEN=

# Server Port (default: 8000)
PORT=8000
